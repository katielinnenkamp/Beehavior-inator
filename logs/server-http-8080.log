b'* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  background: #0f172a; /* dark navy */\n  color: #e2e8f0;\n}\n\n.home-container {\n  width: min(420px, 92vw);\n  padding: 28px;\n  border-radius: 16px;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(8px);\n}\n\nh1 {\n  margin: 0 0 6px;\n  font-size: 1.6rem;\n}\n\n.subtitle {\n  margin: 0 0 18px;\n  opacity: 0.85;\n}\n\n.login-form {\n  display: grid;\n  gap: 10px;\n}\n\nlabel {\n  font-size: 0.9rem;\n  opacity: 0.9;\n}\n\ninput {\n  padding: 12px 12px;\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  background: rgba(0, 0, 0, 0.25);\n  color: inherit;\n  outline: none;\n}\n\ninput:focus {\n  border-color: rgba(255, 255, 255, 0.35);\n}\n\nbutton {\n  margin-top: 6px;\n  padding: 12px;\n  border: 0;\n  border-radius: 10px;\n  cursor: pointer;\n  font-weight: 600;\n}\n\n.sub-submit {\n  margin:6px 0 0;\n  font-size: 0.9rem;\n  opacity: 0.85;\n}\n\n.dashboard {\n  min-height: 10vh;\n}\n\n.dashboard-content {\n  max-width: 600px;\n  margin: 80px auto 0;\n}\n\n.top-left {\n  position: absolute;\n  top: 20px;\n  left: 20px;\n}\n\n.back-button {\n  padding: 10px 14px;\n  border-radius: 10px;\n  text-decoration: none;\n  font-weight: 600;\n  background: rgba(255, 255, 255, 0.1);\n  color: inherit;\n}\n\n.back-button:hover {\n  background: rgba(255, 255, 255, 0.18);\n}\n\n.error {\n  color: #f87171;\n  font-size: 0.9rem;\n  margin-top: -4px;\n}\n\n.hidden {\n  display: none;\n}\n\na {color: #93c5fd; }'

